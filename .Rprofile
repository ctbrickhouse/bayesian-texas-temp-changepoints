if (file.exists("renv/activate.R")) {
  source("renv/activate.R")
} else if (interactive()) {
  message(
    "bayesian.tx.temp: renv is not yet initialized in this repo.\n",
    "First group member with R installed should run:\n",
    "  install.packages('renv'); renv::init()\n",
    "then commit the resulting renv.lock and renv/ folder.\n",
    "See README.md > 'Package management' for details."
  )
}

